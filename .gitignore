# secrets
.env

# Kuku's input pack and the evaluation files stay out of git
input_pack/
*.zip
eval/

# runs and caches: only the official full-pack run and the model-reply cache are committed
outputs/*
!outputs/full_run/
.cache/*
!.cache/llm/

# python
__pycache__/
*.pyc
.DS_Store

# the solution doc quotes the confidential scripts: submit it via the form, don't publish it
docs/solution*.pdf
docs/solution*.html

# the assignment brief itself (Kuku's document): not ours to publish
/Kuku*.pdf

# scripts uploaded through the web UI (confidential, like input_pack/)
uploads/
