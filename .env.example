# Copy to .env and fill in. Any OpenAI-compatible provider works.

# Qubrid AI (default provider). Get a key at https://platform.qubrid.com
QUBRID_API_KEY=

# Optional overrides: swap the model or the whole provider without touching code
# LLM_MODEL=zai-org/GLM-4.7-Flash            # cheapest on Qubrid ($0); see: python3 -m promo_finder models
# LLM_BASE_URL=https://platform.qubrid.com/v1
# LLM_API_KEY=                                # used instead of QUBRID_API_KEY when set
# LLM_EXTRA_BODY={"enable_thinking": false}   # provider-specific extras (JSON); "" to send none
# LLM_WORKERS=1                               # parallel requests (Qubrid free tier allows 1)

# Examples
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1                              LLM_MODEL=gpt-4.1-mini
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1                         LLM_MODEL=llama-3.3-70b-versatile
# Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai LLM_MODEL=gemini-2.5-flash
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1                           LLM_MODEL=<any listed model>
# Local:       LLM_BASE_URL=http://localhost:11434/v1 (Ollama)                     LLM_MODEL=qwen2.5:14b
# Claude etc.: point LLM_BASE_URL at a LiteLLM proxy (https://docs.litellm.ai) in front of any vendor
